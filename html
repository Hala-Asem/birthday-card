<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Happy Birthday 🎂</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;

            background: linear-gradient(
                135deg,
                #0a4384,
                #90bbe9
            );

            font-family: Arial, sans-serif;

            display: flex;
            justify-content: center;
            align-items: center;

            position: relative;
            overflow: hidden;
        }


        /* =====================
           Birthday Card
        ====================== */

        .card {
            width: 400px;

            background-color: white;

            padding: 35px;

            border-radius: 25px;

            display: flex;
            flex-direction: column;
            align-items: center;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.25);

            z-index: 2;
        }


        /* =====================
           Image
        ====================== */

        .birthday-image {
            width: 220px;
            height: 220px;

            object-fit: cover;

            border-radius: 20px;

            margin-bottom: 20px;

            border: 5px solid #60afeb;
        }


        /* =====================
           Cake
        ====================== */

        .cake {
            font-size: 65px;

            margin-bottom: 10px;
        }


        /* =====================
           Title
        ====================== */

        h1 {
            color: #072546;

            font-size: 40px;

            margin-bottom: 15px;
        }


        h2 {
            color: #555;

            margin-bottom: 20px;
        }


        /* =====================
           Text
        ====================== */

        p {
            color: #666;

            font-size: 17px;

            line-height: 1.6;
        }


        .wish {
            margin-top: 20px;

            color: #0f5a80;

            font-weight: bold;

            font-size: 19px;
        }


        /* =====================
           Button
        ====================== */

        .button {
            display: inline-block;

            margin-top: 25px;

            padding: 13px 28px;

            background-color: #09485b;

            color: white;

            text-decoration: none;

            border-radius: 30px;

            font-size: 17px;

            transition: 0.3s;
        }


        .button:hover {
            background-color: #1b60d6;

            transform: scale(1.1);
        }


        /* =====================
           Balloons
        ====================== */

        .balloon {
            position: absolute;

            font-size: 55px;

            animation: float 4s ease-in-out infinite;

            z-index: 1;
        }


        .balloon1 {
            top: 10%;
            left: 8%;
        }


        .balloon2 {
            top: 15%;
            right: 8%;

            animation-delay: 1s;
        }


        .balloon3 {
            bottom: 12%;
            left: 12%;

            animation-delay: 2s;
        }


        .balloon4 {
            bottom: 10%;
            right: 12%;

            animation-delay: 3s;
        }


        /* =====================
           Your Name
        ====================== */

        .my-name {
            position: fixed;

            bottom: 15px;

            left: 0;

            width: 100%;

            text-align: center;

            color: rgb(16, 1, 1);

            font-size: 16px;

            z-index: 5;
        }


        /* =====================
           Animation
        ====================== */

        @keyframes float {

            0%, 100% {
                transform: translateY(0) rotate(-5deg);
            }

            50% {
                transform: translateY(-25px) rotate(5deg);
            }

        }

    </style>

</head>


<body>


    <!-- Balloons -->

    <div class="balloon balloon1">🎈</div>

    <div class="balloon balloon2">🎈</div>

    <div class="balloon balloon3">🎈</div>

    <div class="balloon balloon4">🎈</div>


    <!-- Birthday Card -->

    <div class="card">

        <div class="cake">
            🎂
        </div>


        <!-- Your Image -->

        <img
            src="photo/hesham.jpg"
            alt="Birthday Photo"
            class="birthday-image"
        >


        <h1>
            Happy Birthday!🎉
        </h1>


        <h2>
            Hesham ❤️
        </h2>


        <p>
            Wishing you a beautiful birthday
            filled with happiness, laughter,
            love and wonderful memories.
        </p>


        <p class="wish">
            May all your dreams come true! ✨
        </p>


        <a href="hashomm" class="button">
            🎁 Best Wishes
        </a>

    </div>


    <!-- Your Name -->

    <div class="my-name">
        Made with ❤️ by Hallushka
    </div>


</body>

</html>
